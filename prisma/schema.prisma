// Prisma schema for your PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id           Int      @id @default(autoincrement())
  nom          String?  @db.VarChar(100)
  prenoms      String?  @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  motDePasse   String   @db.VarChar(255)
  telephone    String?  @db.VarChar(50)
  langue       String?  @db.VarChar(20)
  dateCreation DateTime @default(now())
  statut       String?  @db.VarChar(50)

  roles                UtilisateurRole[]
  historiqueActions    HistoriqueAction[]
  factures             Facture[]
  depenses             Depense[]
  revenus              Revenu[]
  prets                Pret[]
  objectifs            Objectif[]
  recommandations      Recommandation[]
  notifications        Notification[]
  parametresNotif      ParametreNotif[]
  devices              Device[]
  sauvegardes          Sauvegarde[]
  userBadges           UserBadge[]
  budgets              Budget[]
  simulations_pret  SimulationPret[]
}

model Role {
  id         Int           @id @default(autoincrement())
  libelle    String        @db.VarChar(50)
  etat       String?       @db.VarChar(50)
  userRoles  UtilisateurRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id         Int           @id @default(autoincrement())
  libelle    String        @db.VarChar(50)
  rolePermissions RolePermission[]
}

model UtilisateurRole {
  utilisateurId Int
  roleId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([utilisateurId, roleId])
}

model RolePermission {
  roleId Int
  permissionId Int
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model HistoriqueAction {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  typeAction  String?  @db.VarChar(100)
  dateAction  DateTime? @default(now())
  details     String?
}

model Categorie {
  id      Int      @id @default(autoincrement())
  libelle String   @db.VarChar(100)
  type    String   @db.VarChar(20)
  depenses Depense[]
  budgets  Budget[]
}

model Facture {
  id            Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  fournisseur   String?   @db.VarChar(100)
  typeFacture   String?   @db.VarChar(50)
  montant       Decimal?  @db.Decimal(12,2)
  dateEmission  DateTime?
  dateEcheance  DateTime?
  statut        String?   @db.VarChar(50)
  moyenPaiement String?   @db.VarChar(50)
  fichiers      Fichier[]
}

model Depense {
  id          Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  categorieId Int?
  categorie   Categorie? @relation(fields: [categorieId], references: [id])
  description String?
  montant     Decimal?  @db.Decimal(12,2)
  dateDepense DateTime?
  typeDepense String?  @db.VarChar(50)
  statut      String?   @db.VarChar(50)
}

model Revenu {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  source     String?   @db.VarChar(100)
  montant    Decimal?  @db.Decimal(12,2)
  dateRevenu DateTime?
  mode       String?   @db.VarChar(50)
}

model Pret {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  crediteur  String?   @db.VarChar(100)
  montant    Decimal?  @db.Decimal(12,2)
  tauxInteret Decimal? @db.Decimal(5,2)
  datePret   DateTime?
  echeance   DateTime?
  statut     String?   @db.VarChar(50)
  remboursements Remboursement[]
}

model Remboursement {
  id         Int       @id @default(autoincrement())
  pretId     Int
  pret       Pret @relation(fields: [pretId], references: [id], onDelete: Cascade)
  montant    Decimal?  @db.Decimal(12,2)
  dateRemb   DateTime?
  statut     String?   @db.VarChar(50)
}

model Objectif {
  id            Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  libelle       String?   @db.VarChar(150)
  montantTotal  Decimal?  @db.Decimal(12,2)
  montantActuel Decimal?  @db.Decimal(12,2) @default(0)
  dateDebut     DateTime?
  dateFin       DateTime?
  statut        String?   @db.VarChar(50)
}

model Recommandation {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  description String?
  type       String?   @db.VarChar(50)
  dateCreation DateTime? @default(now())
}

model Notification {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type       String?   @db.VarChar(50)
  message    String?
  dateNotif  DateTime? @default(now())
  statut     String?   @db.VarChar(50)
}

model ParametreNotif {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  canal      String?   @db.VarChar(50)
  frequence  String?   @db.VarChar(50)
}

model Device {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type       String?   @db.VarChar(50)
  statut     String?   @db.VarChar(50)
  lastSync   DateTime?
}

model Sauvegarde {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  dateSave   DateTime? @default(now())
  type       String?   @db.VarChar(50)
}

model Badge {
  id         Int       @id @default(autoincrement())
  libelle    String?   @db.VarChar(100)
  description String?
  userBadges UserBadge[]
}

model UserBadge {
  utilisateurId Int
  badgeId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  dateObtention DateTime?
  @@id([utilisateurId, badgeId])
}

model Budget {
  id         Int       @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  categorieId Int?
  categorie   Categorie? @relation(fields: [categorieId], references: [id])
  montantLimite Decimal? @db.Decimal(12,2)
  periode    String?   @db.VarChar(20)
}

model Fichier {
  id         Int       @id @default(autoincrement())
  factureId  Int
  facture    Facture @relation(fields: [factureId], references: [id])
  cheminFichier String?
  typeMime   String?   @db.VarChar(50)
}

model SimulationPret {
  id        Int      @id @default(autoincrement())
  id_user   Int
  utilisateur Utilisateur @relation(fields: [id_user], references: [id], onDelete: Cascade)
  
  // Données de base de la simulation
  nom_simulation    String?   @db.VarChar(100)
  salaire_net       Decimal   @db.Decimal(12,2)
  duree_salaire     Int       // en mois
  taux_salaire      Decimal   @db.Decimal(5,2)
  capacite_emprunt  Decimal   @db.Decimal(12,2)
  duree_emprunt     Int       // en mois
  taux_emprunt      Decimal   @db.Decimal(5,2)
  
  // Résultats calculés - Salaire
  quotite_cessible        Decimal  @db.Decimal(12,2)
  montant_max_salaire     Decimal  @db.Decimal(12,2)
  net_cav_salaire         Decimal  @db.Decimal(12,2)
  frais_ht_salaire        Decimal  @db.Decimal(12,2)
  taxe_salaire            Decimal  @db.Decimal(12,2)
  frais_ttc_salaire       Decimal  @db.Decimal(12,2)
  fond_emprunteur_salaire Decimal  @db.Decimal(12,2)
  
  // Résultats calculés - Emprunt
  montant_max_emprunt     Decimal  @db.Decimal(12,2)
  net_cav_emprunt         Decimal  @db.Decimal(12,2)
  frais_ht_emprunt        Decimal  @db.Decimal(12,2)
  taxes_emprunt           Decimal  @db.Decimal(12,2)
  frais_ttc_emprunt       Decimal  @db.Decimal(12,2)
  fond_solidarite_emprunt Decimal  @db.Decimal(12,2)
  
  // Tableau final
  table_emprunt        Decimal  @db.Decimal(12,2)
  table_duree          Int
  table_taux           Decimal  @db.Decimal(5,2)
  table_echeance       Decimal  @db.Decimal(12,2)
  table_taux_fd_ht     Decimal  @db.Decimal(5,2)
  table_fd_ht          Decimal  @db.Decimal(12,2)
  table_fd_ttc         Decimal  @db.Decimal(12,2)
  table_fse            Decimal  @db.Decimal(12,2)
  table_net_cav        Decimal  @db.Decimal(12,2)
  table_total_interet  Decimal  @db.Decimal(12,2)
  table_total_ci       Decimal  @db.Decimal(12,2)
  
  date_creation        DateTime @default(now())
  date_modification    DateTime @updatedAt
  statut               String?  @default("brouillon") @db.VarChar(50)
  
  @@map("simulations_pret")
}

model EcheancierPret {
  id                 Int      @id @default(autoincrement())
  id_simulation      Int
  simulation         SimulationPret @relation(fields: [id_simulation], references: [id], onDelete: Cascade)
  
  numero_echeance    Int
  date_echeance      DateTime
  montant_echeance   Decimal  @db.Decimal(12,2)
  capital            Decimal  @db.Decimal(12,2)
  interet            Decimal  @db.Decimal(12,2)
  capital_restant    Decimal  @db.Decimal(12,2)
  
  @@map("echeanciers_pret")
}
